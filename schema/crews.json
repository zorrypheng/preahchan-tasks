{
  "id": "pc_crews0000001",
  "name": "crews",
  "type": "base",
  "listRule": "@request.auth.id != \"\"",
  "viewRule": "@request.auth.id != \"\"",
  "createRule": "@request.body.owner = @request.auth.id && @request.auth.role != \"staff\"",
  "updateRule": "owner = @request.auth.id || (@request.auth.role = \"admin\" || @request.auth.role = \"manager\")",
  "deleteRule": "owner = @request.auth.id || (@request.auth.role = \"admin\" || @request.auth.role = \"manager\")",
  "fields": [
    {
      "name": "name",
      "type": "text",
      "required": true,
      "max": 80
    },
    {
      "name": "type",
      "type": "text",
      "max": 30
    },
    {
      "name": "plan",
      "type": "json",
      "maxSize": 20000
    },
    {
      "name": "owner",
      "type": "relation",
      "collectionId": "_pb_users_auth_",
      "maxSelect": 1,
      "cascadeDelete": false
    },
    {
      "name": "created",
      "type": "autodate",
      "onCreate": true,
      "onUpdate": false
    },
    {
      "name": "updated",
      "type": "autodate",
      "onCreate": true,
      "onUpdate": true
    }
  ]
}
